@@ -99,3 +99,51 @@ end $$;
 -- Solo el servidor puede ejecutarla (en Supabase las funciones nuevas quedan abiertas a anon por defecto)
 revoke execute on function aprobar_pedido(text, text, bigint, text) from public, anon, authenticated;
 grant execute on function aprobar_pedido(text, text, bigint, text) to service_role;
+
+-- ============================================================================
+-- v4 · catálogo administrable, tarifa de envío, despacho y registro de eventos
+-- (todo aditivo e idempotente: no toca aprobar_pedido ni los pedidos existentes)
+-- ============================================================================
+alter table productos add column if not exists descripcion text not null default '';
+alter table productos add column if not exists imagen text;
+alter table productos add column if not exists imagenes jsonb not null default '[]';
+alter table productos add column if not exists colores jsonb not null default '[]';   -- [{"n":"Negro","h":"#111111"}]
+alter table productos add column if not exists coleccion text;
+alter table productos add column if not exists destacado boolean not null default false;
+alter table productos add column if not exists orden int not null default 0;
+alter table productos add column if not exists actualizado_en timestamptz not null default now();
+
+-- Envío cobrado y subtotal quedan guardados en cada pedido: cambiar la tarifa no altera pedidos viejos.
+-- subtotal_centavos es null en pedidos anteriores a esta versión (monto_centavos ya era el total).
+alter table pedidos add column if not exists subtotal_centavos bigint;
+alter table pedidos add column if not exists envio_centavos bigint not null default 0;
+alter table pedidos add column if not exists preparado_en timestamptz;
+alter table pedidos add column if not exists incidencia text;
+alter table pedidos add column if not exists nota_despacho text;
+create unique index if not exists pedidos_clave_unica on pedidos ((meta->>'clave')) where meta->>'clave' is not null;  -- anti pedidos duplicados
+alter table pedidos drop constraint if exists pedidos_monto_coherente;
+alter table pedidos add constraint pedidos_monto_coherente
+  check (subtotal_centavos is null or monto_centavos = subtotal_centavos + envio_centavos);
+
+-- Ajustes de la tienda (fuente única): 'envio' = {"tarifa": pesos COP}, 'contenido' = textos/secciones/colecciones
+create table if not exists ajustes (
+  clave text primary key,
+  valor jsonb not null,
+  actualizado_en timestamptz not null default now()
+);
+insert into ajustes (clave, valor) values ('envio', '{"tarifa": 17500}') on conflict (clave) do nothing;
+
+-- Registro de eventos importantes (pedidos creados, pagos, cambios del panel)
+create table if not exists eventos (
+  id bigint generated always as identity primary key,
+  tipo text not null,
+  referencia text,
+  detalle jsonb not null default '{}',
+  creado_en timestamptz not null default now()
+);
+create index if not exists eventos_creado_en on eventos (creado_en desc);
+
+alter table ajustes enable row level security;
+alter table eventos enable row level security;
+revoke all on table ajustes, eventos from anon, authenticated;
+grant all on table ajustes, eventos to service_role;
