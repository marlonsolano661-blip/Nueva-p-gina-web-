# Estas variables NO se suben a GitHub. Se cargan en el panel de tu hosting (Vercel o Netlify):
#   Settings > Environment Variables. Copia los nombres y pega los valores reales.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=            # la llave SECRETA (service_role o sb_secret_...). Jamás la publica

# Wompi > Desarrolladores (primero con llaves de PRUEBA, luego las de producción)
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx           # en producción: pub_prod_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxx   # "Secreto de integridad"
WOMPI_EVENTS_SECRET=test_events_xxxx         # "Secreto de eventos"

# Dominio público de tu tienda, sin barra final
SITE_URL=https://tienda.mfcol.com

# Panel de pedidos: inventa una clave larga y aleatoria (mínimo 24 caracteres)
ADMIN_TOKEN=

# Opcionales
# ALLOWED_ORIGIN=https://otro-dominio.com   # solo si la página y la API están en dominios distintos
# WOMPI_VERIFY_API=0                        # NO recomendado: desactiva la confirmación con la API de Wompi
