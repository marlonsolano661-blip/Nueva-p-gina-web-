  var ya={};(it.fotos||[]).forEach(function(f){ya[typeof f==="string"?f:f.u]=1});
  (P.imgs||[]).forEach(function(u){if(!ya[u]){ya[u]=1;(it.fotos=it.fotos||[]).push(u)}});
