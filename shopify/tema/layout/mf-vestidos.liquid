  Promise.resolve({productos:window.MF_SHOPIFY_CATALOGO||[]}).then(function(d){
    if(!d||!Array.isArray(d.productos))return;var C=CAT;d.productos.forEach(function(p){C[p.id]=p});
    LOOKS.forEach(function(L){sincronizar(L.tacon,C[L.tacon&&L.tacon.id]);if(L.prenda.venta)sincronizar(L.prenda.venta,C[L.prenda.venta.id]);
      if(cur>-1&&$("lookView").classList.contains("on")&&L===LOOKS[cur]){creditos(L,$("crV").classList.contains("on"),$("crT").classList.contains("on"))}});
  }).catch(function(){});
}

/* ---------------- Arranque ---------------- */
/* Los looks salen del panel (/api/vestidos); si el panel nunca guardó o no responde, se usan los de vestidos/looks.js */
var arrancado=false;
function arrancar(lista){
  if(arrancado)return;arrancado=true;
  if(Array.isArray(lista))LOOKS=lista.slice();
  started=performance.now();
  if(matchMedia("(hover: hover) and (pointer: fine)").matches)$("fingerT").textContent="clic para ver la espalda · arrastra para girarla";
  LOOKS.forEach(function(L){[L.prenda.frente,L.prenda.espalda,L.foto.src].concat(L.foto.sesion||[]).forEach(function(s){if(s){var i=new Image();i.src=s}})});
  if(!LOOKS.length){$("rackView").querySelector(".h1").textContent="Muy pronto";}
  buildRack();requestAnimationFrame(tick);
  sincronizarCatalogo();
}
(function(){
  var API=window.MF_API_BASE||"",t=setTimeout(function(){arrancar(null)},2500);
  Promise.resolve(null).then(function(d){clearTimeout(t);arrancar(d&&Array.isArray(d.looks)?d.looks:null)}).catch(function(){clearTimeout(t);arrancar(null)});
})();
var rz;addEventListener("resize",function(){clearTimeout(rz);rz=setTimeout(function(){if(!piece){buildRack();items.forEach(function(it){it.on=it.arr=true;it.el.style.opacity=1});started=-1e9}
  if($("lookView").classList.contains("on"))layoutPhoto(LOOKS[cur])},150)});
})();
