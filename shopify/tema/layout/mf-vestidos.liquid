function sincronizar(it,P){
  if(!it||!P)return;
  it.n=P.name||it.n;if(P.price>0)it.p=P.price;
  var todas=TODAS[P.tipo]||it.tallas;it.tallas=todas.slice();
  it.agotadas=todas.filter(function(t){return (P.tallas||[]).indexOf(t)<0});
  if(P.colors&&P.colors.length){
