 ${W?`<p class="ds">Si WhatsApp no se abrió, toca el botón para enviar tu pedido.</p><a class="btn" href="${waLink(msg(L))}" target="_blank" rel="noopener">${I.wa} Abrir WhatsApp</a>`:`<p class="ds"><b>${esc(L.c.pay)}:</b> ${esc(py?py.t:'')}</p><a class="btn" href="${waLink('Hola! Ya hice mi pedido '+L.num+' y quiero coordinar el pago ('+L.c.pay+').')}" target="_blank" rel="noopener">${I.wa} Coordinar pago por WhatsApp</a>`}
 <div style="margin-top:1rem"><button class="btn o" data-n="go" data-p="col">Seguir comprando</button></div></section>`}
function saveOrder(L){if(!real)return;try{const A=JSON.parse(localStorage.getItem('marlon_admin_v1')),f=new Date(),d=new Date(f-f.getTimezoneOffset()*6e4).toISOString().slice(0,10);
 L.lines.forEach(l=>{const p=A.products.find(x=>x.id==l.id);A.rows.push({id:Date.now()+Math.floor(Math.random()*1e6),fecha:d,cliente:L.c.nombre,tel:L.c.tel,producto:l.name,talla:l.talla,color:l.color||'',cant:l.q,precio:l.price,costo:p?p.cost:0,pago:'Pendiente',estado:'Nuevo',ciudad:L.c.ciudad,direccion:L.c.dir,transp:'',guia:'',origen:L.mode==='wa'?'WhatsApp':'Tienda web'})});
 localStorage.setItem('marlon_admin_v1',JSON.stringify(A))}catch(e){}}
function submit(){const c=FRM;{const er=frmOk();if(er)return toast(er)}if(!c.pay)return toast('Elige un medio de pago');
 LAST={mode,num:'MF-'+String(Date.now()).slice(-6),c:{...c},lines:CART.slice(),total:total()};saveOrder(LAST);CART=[];saveCart();nav('done');
 if(mode==='wa')window.open(waLink(msg(LAST)),'_blank')}
function add(id){const p=catalog().find(x=>String(x.id)===String(id));if(!p)return false;if(!selT){toast('Elige tu talla');return false}
 const cn=(p.colors[selC]||{}).n||'',l=CART.find(x=>String(x.id)===String(id)&&x.talla===selT&&(x.color||'')===cn);if(l)l.q++;else CART.push({id:p.id,name:p.name,price:p.price,img:(p.colors[selC]||{}).img||p.img,talla:selT,color:cn,q:1});saveCart();return true}
const PG={home,col,prod,cart,out,pay:payPg,done};


/* ====== Comunidad Marlon ====== */
/* Looks aprobados: agrega aquí cada uno cuando lo apruebes. Ej: {img:'looks/ana.jpg',n:'Ana M.',t:'Me encantaron mis MF.',ig:'@ana',v:true}  (v:true = compra verificada) */
const LOOKS=[];
const DEMO_LOOKS=[];
const CK='<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#0c0c0c"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const CKO='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M8 12.5l2.6 2.6L16 9.5"/></svg>';
const lookCard=l=>`<article class="lc"><div class="im">${l.img?`<img src="${esc(l.img)}" alt="Look de ${esc(l.n)}" loading="lazy">`:'Foto del look'}</div><p>${esc(l.t||'')}</p><div class="lkn">${esc(l.n)}${l.v?CK:''}</div>${l.ig?`<small>${esc(l.ig)}</small>`:''}</article>`;
const lookPub=()=>{const l=window.MF_CONTENIDO&&window.MF_CONTENIDO.looks;return Array.isArray(l)?l.filter(x=>x&&x.img&&x.n):[]};
const communityH=()=>{const P=lookPub();const L=P.length?P:(LOOKS.length?LOOKS:(real?[]:DEMO_LOOKS));
 return `<section class="wrap com"><h2 class="st">Comunidad Marlon</h2><p class="ds ctr">Looks reales. Estilo propio.</p><div class="lks">${L.length?L.map(lookCard).join(''):`<article class="lc"><div class="im">MF</div><p>Sé la primera en aparecer en Comunidad Marlon.</p></article>`}</div><div class="ctr"><button class="btn" data-n="shopen">Comparte tus MF</button><p class="ds sm">Compártenos tu outfit. Lo revisamos antes de publicarlo.</p></div></section>`};
let shStep='g';const LK={nombre:'',mensaje:'',ig:'',ok:false,file:null,url:'',err:''};
function renderSheet(){const s=$('#sh');if(!s)return;let b='';
 if(shStep==='g')b=`<h2>Comparte tus MF</h2><p class="ds">Compártenos tu outfit y aparece en Comunidad Marlon.</p><ul class="tips"><li>${CKO}Que se vean tus MF.</li><li>${CKO}Con buena luz.</li><li>${CKO}Tu mejor outfit.</li></ul><p class="ds sm">Revisamos cada foto antes de publicarla.</p><div class="cta" style="margin-top:1.2rem"><button class="btn wide" data-n="shstep" data-s="f">Subir mi foto ${AR}</button><button class="lk" data-n="shclose">Ahora no</button></div>`;
 else if(shStep==='f')b=`<h2>Tu outfit</h2><label class="drop" id="lkdrop">${LK.url?`<img src="${LK.url}" alt="Tu foto">`:'<span>Toca para subir tu foto con tus MF</span>'}<input class="vh" id="lkf" type="file" accept="image/*"></label><div class="fg"><div class="f"><label for="l-n">Nombre</label><input id="l-n" data-l="nombre" type="text" value="${esc(LK.nombre)}" autocomplete="name"></div><div class="f"><label for="l-m">Cuéntanos algo (opcional)</label><textarea id="l-m" data-l="mensaje" rows="2" placeholder="Cómo los combinaste">${esc(LK.mensaje)}</textarea></div><div class="f"><label for="l-i">Instagram (opcional)</label><input id="l-i" data-l="ig" type="text" placeholder="@usuario" value="${esc(LK.ig)}"></div></div><label class="ck"><input type="checkbox" data-l="ok"${LK.ok?' checked':''}>Autorizo a Marlon Footwear a publicar mi foto.</label><button class="btn wide" data-n="sendlook">Compartir mi outfit</button><p class="ds sm ctr" style="margin:.8rem 0 0">La revisamos antes de publicarla.</p>`;
 else if(shStep==='s')b=`<div class="empty"><p>Enviando tu outfit…</p></div>`;
 else if(shStep==='d')b=`<div class="ctr"><div class="ok">✓</div><h2>¡Gracias!</h2><p class="ds">Recibimos tu outfit. Lo revisamos y, si queda perfecto, aparecerá en Comunidad Marlon.</p><button class="btn wide" data-n="shclose" style="margin-top:1rem">Listo</button></div>`;
 else b=`<div class="ctr"><h2>No pudimos enviar tu foto</h2><p class="ds">${LK.err?esc(LK.err):'Revisa tu conexión e inténtalo de nuevo, o envíanosla por WhatsApp.'}</p><div class="cta" style="margin-top:1rem"><button class="btn wide" data-n="shstep" data-s="f">Intentar de nuevo</button><a class="btn o wide" href="${waLink('Hola! Quiero compartir mi outfit con mis MF en Comunidad Marlon.')}" target="_blank" rel="noopener">${I.wa} Enviar por WhatsApp</a></div></div>`;
 s.innerHTML=`<div class="hd"></div>${b}`}
function openSheet(){window.open('https://wa.me/'+WA+'?text='+encodeURIComponent('Hola MF 👋 Quiero compartir mi outfit con mis MF para Comunidad Marlon'),'_blank');return;shStep='g';renderSheet();document.body.classList.add('shopen');$('#sh').setAttribute('aria-hidden','false');setTimeout(()=>{const x=$('#sh .btn');if(x)x.focus()},60)}
function closeSheet(){if(!document.body.classList.contains('shopen'))return;document.body.classList.remove('shopen');$('#sh').setAttribute('aria-hidden','true')}
const shrink=f=>new Promise((res,rej)=>{const im=new Image(),u=URL.createObjectURL(f);im.onload=()=>{const k=Math.min(1,1600/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);c.toBlob(b=>b?res(b):rej(),'image/jpeg',.85)};im.onerror=rej;im.src=u});
async function sendLook(){if(!LK.file)return toast('Sube tu foto');if(!LK.nombre.trim())return toast('Escribe tu nombre');if(!LK.ok)return toast('Acepta la autorización');
 shStep='s';renderSheet();
 try{const blob=await shrink(LK.file),foto=await new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>ok(r.result);r.onerror=no;r.readAsDataURL(blob)});
  const r=await (function(){return Promise.resolve({ok:false,json:function(){return Promise.resolve({error:'Envíanos tu foto por WhatsApp'})}})})({method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nombre:LK.nombre,mensaje:LK.mensaje,instagram:LK.ig,autoriza:true,foto,web:''})});
  if(!r.ok){const d=await r.json().catch(()=>({}));throw new Error(d.error||'')}
  shStep='d';LK.nombre=LK.mensaje=LK.ig=LK.url='';LK.ok=false;LK.file=null}catch(e){shStep='e';LK.err=(e&&e.message)||''}renderSheet()}
document.addEventListener('change',e=>{if(e.target.id!=='lkf')return;const f=e.target.files[0];if(!f)return;LK.file=f;LK.url=URL.createObjectURL(f);$('#lkdrop').innerHTML=`<img src="${LK.url}" alt="Tu foto"><input class="vh" id="lkf" type="file" accept="image/*">`});

/* ====== Bolsa (cajón) ====== */
let bumpI=-1;
const AR='<svg class="ar" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const bagLine=(l,i)=>`<article class="bl"><div class="im sm">${imgH(l)}</div><div class="bi"><h3>${esc(l.name)}</h3><p>${l.color?esc(l.color)+' · ':''}Talla ${esc(l.talla)}</p><div class="bq"><div class="qs"><button data-n="q" data-i="${i}" data-d="-1" aria-label="Menos">−</button><b class="${i===bumpI?'pop':''}">${l.q}</b><button data-n="q" data-i="${i}" data-d="1" aria-label="Más">+</button></div><span class="lp">${fmt(l.price*l.q)}</span></div><button class="rm" data-n="rm" data-i="${i}">Quitar</button></div></article>`;
const agotada=l=>{const p=catalog().find(x=>x.id===l.id);return !!p&&!(p.tallas||[]).map(String).includes(String(l.talla))};
function renderBag(){const d=$('#dr');if(!d)return;const AG=CART.filter(agotada);
 d.innerHTML=`<header class="drh"><div><h2 id="drt">Tu bolsa</h2><p>Revisa tu selección antes de pagar.</p></div><button class="x" data-n="bagclose" aria-label="Cerrar bolsa"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg></button></header>
 <div class="drb">${CART.length?CART.map(bagLine).join(''):`<div class="empty"><p>Tu bolsa está vacía.</p><button class="btn" data-n="bagclose">Ver modelos</button></div>`}</div>
 ${CART.length?`<footer class="drf">${AG.length?`<div class="agt" role="alert"><b>Esta talla ya se agotó</b><span>${AG.map(l=>esc(l.name)+' · talla '+esc(l.talla)).join(', ')}</span><button class="btn o s" data-n="rmsold">Quitar de la bolsa</button></div>`:''}${tot()}<div class="cta"><button class="btn wide" data-n="go" data-p="out"${AG.length?' disabled':''}>Pagar en línea ${AR}</button><button class="btn o wide wa" data-n="wacart">${I.wa}<span><b>Enviar carrito a WhatsApp</b><small>Envía tu carrito por WhatsApp y recibe asesoría personalizada.</small></span></button></div><button class="lk" data-n="bagclose">Seguir comprando</button></footer>`:''}`;bumpI=-1}
let lastFocus=null;
function openBag(){lastFocus=document.activeElement;$('#toast').classList.remove('on');renderBag();document.body.classList.add('bagopen');$('#dr').setAttribute('aria-hidden','false');setTimeout(()=>{const x=$('#dr .x');if(x)x.focus()},60)}
function closeBag(){if(!document.body.classList.contains('bagopen'))return;document.body.classList.remove('bagopen');$('#dr').setAttribute('aria-hidden','true');if(lastFocus&&lastFocus.focus)lastFocus.focus()}
function bagBump(){const b=$('.bag');if(!b)return;b.classList.remove('bump');void b.offsetWidth;b.classList.add('bump')}
addEventListener('keydown',e=>{if(e.key==='Escape'){closeBag();closeSheet()}});
document.addEventListener('pointerdown',e=>{const b=e.target.closest('.btn');if(!b)return;const r=b.getBoundingClientRect();b.style.setProperty('--x',(e.clientX-r.left)+'px');b.style.setProperty('--y',(e.clientY-r.top)+'px');b.classList.remove('rip');void b.offsetWidth;b.classList.add('rip')});

